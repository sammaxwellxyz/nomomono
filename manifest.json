{
  "manifest_version": 3,
  "name": "nomomono",
  "version": "1.0",
  "description": "Replaces monospace body text in <p> elements with a legible sans-serif.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
